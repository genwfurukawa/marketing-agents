def write_brand_radar_prompts():
    """Brand Radar UI prompts: ALL 20 Arel baseline queries + 10 highest-leverage supplementary = 30."""
    baseline = [q for q in QUERIES if q.get("baseline")]
    # 24 baseline (Q10 expanded to 5). Take all 24.
    supplementary_picks = [
        "Best speaker marketplaces 2026",
        "Speaker bureau vs speaker marketplace which should I use",
        "How do I verify a speaker's audience feedback?",
        "Speaker performance data by topic",
        "Speaker industry data and trends 2026",
        "How do speakers get booked",
    ]
    supplementary = [q for q in QUERIES if q["q"] in supplementary_picks]
    selected = baseline + supplementary

    p = OUT / "_inputs/brand_radar_prompts.md"
    lines = [
        "# Brand Radar Prompts — Talkadot Project (Ahrefs)",
        "",
        f"**Total prompts: {len(selected)}** ({len(baseline)} Arel baseline queries + {len(supplementary)} supplementary)",
        "",
        "## Strategic note",
        "",
        "Arel's 20 baseline queries (Section 10 of his AEO Strategy doc) are the success metric.",
        "Talkadot must appear in at least 8 of 20 at 90 days, 14 of 20 at 180 days.",
        "Q10 ('Talkadot vs [top competitor]') is expanded to all 5 specific competitor comparisons because the brand-radar UI needs concrete prompts.",
        "",
        "## How to add",
        "",
        "1. Open Ahrefs → Brand Radar → Talkadot project's report (id `019db635-ba2e-7164-bbbd-b2b5d52285b8`)",
        "2. Confirm data sources are ON: ChatGPT, Gemini, Perplexity (Copilot + Grok optional bonus)",
        "3. Paste each prompt below into the Custom Prompts list",
        "4. Save. Brand Radar will populate trend data over 1-2 weeks.",
        "",
        "## Prompts (paste-ready)",
        "",
        "### Arel baseline (success metric — track every week)",
        "",
    ]
    for i, q in enumerate(baseline, 1):
        lines.append(f"{i}. {q['q']}")
    lines += [
        "",
        "### Supplementary (extends category coverage)",
        "",
    ]
    for i, q in enumerate(supplementary, len(baseline) + 1):
        lines.append(f"{i}. {q['q']}")
    lines += [
        "",
        f"**Total: {len(selected)} prompts**",
    ]
    p.write_text("\n".join(lines))
    return p


