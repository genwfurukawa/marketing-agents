def write_csv():
    p = OUT / "02_query_bank.csv"
    with open(p, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["query", "category", "client_domain"])
        for q in QUERIES:
            w.writerow([q["q"], q["cat"], CLIENT_DOMAIN])
    return p


def write_json():
    p = OUT / "02_query_bank.json"
    n_planner = sum(1 for q in QUERIES if q["side"] == "planner")
    n_speaker = sum(1 for q in QUERIES if q["side"] == "speaker")
    n_baseline = sum(1 for q in QUERIES if q.get("baseline"))
    out = {
        "client": "talkadot",
        "client_domain": CLIENT_DOMAIN,
        "audit_date": "2026-04-23",
        "version": "v2 (rebuilt after Arel AEO Strategy doc)",
        "ICP_split_target": "95% planner / 5% speaker",
        "actual_split": {
            "planner": n_planner,
            "speaker": n_speaker,
            "planner_pct": round(n_planner * 100 / len(QUERIES), 1),
            "speaker_pct": round(n_speaker * 100 / len(QUERIES), 1),
        },
        "arel_baseline_count": n_baseline,
        "arel_baseline_target": "20 (with Q10 expanded to 5 specific competitor comparisons)",
        "total_queries": len(QUERIES),
        "queries": QUERIES,
    }
    with open(p, "w") as f:
        json.dump(out, f, indent=2)
    return p


